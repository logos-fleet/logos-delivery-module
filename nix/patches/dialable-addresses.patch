index 000000000000..32e7d08a70ae
--- /dev/null
+++ b/tests/test_delivery_dialer.nim
@@ -0,0 +1,53 @@
+{.used.}
+
+## The dial side of logos-workspace#209. DeliveryDialer replaces the switch
+## dialer, so every dial in the process passes through it -- which makes it the
+## one place that can refuse an address no connect() could ever have completed.
+
+import std/strutils
+import testutils/unittests, chronos
+import libp2p/[multiaddress, switch]
+import libp2p/protocols/connectivity/relay/relay
+import logos_delivery/waku/node/[waku_switch, delivery_dialer]
+import ./testlib/[common, wakucore]
+
+proc ma(s: string): MultiAddress =
+  MultiAddress.init(s).get()
+
+suite "Delivery dialer":
+  asyncTest "a dial whose every address is un-dialable never reaches a transport":
+    ## The 866 `Dialing failed` lines on the device were 364 of these plus the
+    ## peers behind them: /ip4/0.0.0.0/... and /tcp/0 are listen arguments that
+    ## leaked into somebody's peer record, and each one cost a full connect().
+    let sw = newWakuSwitch(rng = rng(), circuitRelay = Relay.new())
+    await sw.start()
+    let target = newTestSwitch().peerInfo.peerId
+
+    var raised = ""
+    try:
+      await sw.connect(
+        target, @[ma("/ip4/0.0.0.0/tcp/53024"), ma("/ip4/127.0.0.1/tcp/0")]
+      )
+    except DialFailedError as e:
+      raised = e.msg
+
+    check:
+      "no dialable address" in raised
+      "wildcard bind address" in raised ## every drop is named once
+      "port 0" in raised
+    await sw.stop()
+
+  asyncTest "a usable address beside an un-dialable one still connects":
+    ## The screen must not eat the dial. Same shape a rendezvous record has
+    ## when the publisher announced both its wildcard bind and a real endpoint.
+    let
+      dialer = newWakuSwitch(rng = rng(), circuitRelay = Relay.new())
+      dest = newWakuSwitch(rng = rng(), circuitRelay = Relay.new())
+    await allFutures(dialer.start(), dest.start())
+
+    await dialer.connect(
+      dest.peerInfo.peerId, @[ma("/ip4/0.0.0.0/tcp/1")] & dest.peerInfo.addrs
+    )
+    check dialer.isConnected(dest.peerInfo.peerId)
+
+    await allFutures(dialer.stop(), dest.stop())

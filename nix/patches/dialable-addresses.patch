@@ -35,9 +74,17 @@ method connect*(
     dir = Direction.Out,
 ) {.async: (raises: [DialFailedError, CancelledError]).} =
   await procCall Dialer(self).connect(
-    peerId, sortQuicFirst(addrs), forceDial, reuseConnection, dir
+    peerId, admitOrRefuse(peerId, addrs), forceDial, reuseConnection, dir
   )
 
+method connect*(
+    self: DeliveryDialer, address: MultiAddress, allowUnknownPeerId = false
+): Future[PeerId] {.async: (raises: [DialFailedError, CancelledError]).} =
+  ## The peer-id-less overload, used for statically configured endpoints.
+  if not address.isUsableAddr():
+    raise refuse("an unknown peer", @[address])
+  await procCall Dialer(self).connect(address, allowUnknownPeerId)
+

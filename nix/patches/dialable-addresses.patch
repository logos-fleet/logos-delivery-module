index 000000000000..3ecfd9feb5fa
--- /dev/null
+++ b/logos_delivery/waku/net/dialable.nim
@@ -0,0 +1,94 @@
+{.push raises: [].}
+
+## Which multiaddresses may cross the network -- see logos-workspace#209.
+##
+## Peer discovery hands this node addresses that can never be reached from
+## anywhere: the wildcard bind address (`/ip4/0.0.0.0/...`, `/ip6/::/...`) and
+## the pre-bind port placeholder (`/tcp/0`, `/udp/0`). Both are *listen*
+## arguments that leaked into somebody's published peer record; as destinations
+## they are invalid by construction and can be refused without a network round
+## trip. On one physical-device run they cost 364 of 866 `Dialing failed`
+## lines, every one of them a full connect() that could not have worked.
+##
+## The same two rules screen what this node publishes: an address it could not
+## dial itself is no use to a reader either.
+##
+## logos-libp2p-module carries the same rule set in `src/addr_filter.{h,cpp}`
+## (logos-workspace#206). Its third verdict, `Loopback`, is deliberately NOT
+## carried here. Loopback IS dialable -- it reaches this host -- so it is a
+## publish-side question only, and its answer depends on the platform (on a
+## phone loopback is the device and nobody else; in the iOS simulator it is the
+## Mac's, and a peer there does answer). waku resolves a loopback bind to
+## loopback on purpose and pins that in `tests/test_announced_addresses.nim`,
+## so a verdict for it here would change behaviour this file is not about.
+##
+## Pure functions over a MultiAddress. Nothing here needs a node or a socket,
+## which is what lets `tests/test_dialable.nim` cover every case in one run.
+
+import std/[sequtils, strutils]
+import results
+import stew/endians2
+import libp2p/[multiaddress, multicodec]
+
+type AddrVerdict* = enum
+  Usable
+  Wildcard ## unspecified host: /ip4/0.0.0.0, /ip6/::
+  ZeroPort ## /tcp/0, /udp/0 -- "bind me any free port", never a destination
+
+func describe*(v: AddrVerdict): string =
+  case v
+  of Usable: "ok"
+  of Wildcard: "wildcard bind address"
+  of ZeroPort: "port 0"
+
+func hasZeroPort*(ma: MultiAddress): bool =
+  ## Port 0 means "the kernel picks a port at bind time".
+  ## initTAddress cannot parse dns-hosted entries, so read the port
+  ## bytes from the tcp or udp component directly.
+  for code in [multiCodec("tcp"), multiCodec("udp")]:
+    let part = ma[code].valueOr:
+      continue
+    let portBytes = part.protoArgument().valueOr:
+      continue
+    if portBytes.len == 2 and uint16.fromBytesBE(portBytes) == 0:
+      return true
+  return false
+
+func hasWildcardHost*(ma: MultiAddress): bool =
+  ## True only for an ip4/ip6 component that is positively the unspecified
+  ## address. An entry with no IP component to read -- a dns4 endpoint, a
+  ## circuit route -- is not condemned here; a shape this cannot judge is left
+  ## to the transport to accept or refuse, never silently dropped.
+  for code in [multiCodec("ip4"), multiCodec("ip6")]:
+    let part = ma[code].valueOr:
+      continue
+    let bytes = part.protoArgument().valueOr:
+      continue
+    if bytes.len > 0 and bytes.allIt(it == 0'u8):
+      return true
+  return false
+
+func classify*(ma: MultiAddress): AddrVerdict =
+  ## Port 0 outranks the wildcard host: an address carrying both is named by
+  ## the fault an operator reading the log sees most.
+  if ma.hasZeroPort():
+    return ZeroPort
+  if ma.hasWildcardHost():
+    return Wildcard
+  return Usable
+
+func isUsableAddr*(ma: MultiAddress): bool =
+  ma.classify() == Usable
+
+func usableAddrs*(addrs: openArray[MultiAddress]): seq[MultiAddress] =
+  ## Order is preserved.
+  addrs.filterIt(it.isUsableAddr())
+
+func describeUnusable*(addrs: openArray[MultiAddress]): string =
+  ## "<address> (<reason>)" per rejected entry, joined -- one log line.
+  var notes: seq[string]
+  for ma in addrs:
+    let verdict = ma.classify()
+    if verdict != Usable:
+      notes.add($ma & " (" & describe(verdict) & ")")
+  return notes.join(", ")

   )
 
+proc admit(addrs: seq[MultiAddress]): seq[MultiAddress] =
+  ## The dial order, minus whatever cannot be a destination.
+  ##
+  ## `/ip4/0.0.0.0/...` and `/tcp/0` are LISTEN arguments that leak into
+  ## published peer records; discovery then hands them back as somewhere to
+  ## dial. They are invalid by construction, so refusing them here costs one
+  ## comparison where letting them through costs a full connect() that cannot
+  ## succeed -- logos-workspace#209 measured 364 such dials in one device run.
+  let kept = usableAddrs(addrs)
+  if kept.len != addrs.len:
+    debug "Screened un-dialable addresses", dropped = describeUnusable(addrs)
+  sortQuicFirst(kept)
+
+proc noneLeft(original, admitted: seq[MultiAddress]): bool =
+  ## Distinguishes "the caller named nothing" -- libp2p's own case, left to
+  ## libp2p -- from "everything the caller named was un-dialable".
+  admitted.len == 0 and original.len > 0
+
+proc refuse(peer: string, addrs: seq[MultiAddress]): ref DialFailedError =
+  newException(
+    DialFailedError,
+    "no dialable address for " & peer & ": " & describeUnusable(addrs),
+  )
+
+proc admitOrRefuse(
+    peerId: PeerId, addrs: seq[MultiAddress]
+): seq[MultiAddress] {.raises: [DialFailedError].} =
+  ## `admit`, for the three methods whose answer to "nothing survived" is to
+  ## refuse the dial. `dialAndUpgrade` is the one that answers nil instead and
+  ## screens inline.
+  result = admit(addrs)
+  if noneLeft(addrs, result):
+    raise refuse($peerId, addrs)
+

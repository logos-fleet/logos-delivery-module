index 000000000000..ce99b4ef00d6
--- /dev/null
+++ b/tests/test_dialable.nim
@@ -0,0 +1,85 @@
+{.used.}
+
+## The admission rules for an address that crosses the network.
+## Cases transferred from logos-libp2p-module's addr_filter unit suite
+## (logos-workspace#206), minus its platform-conditional Loopback verdict.
+
+import std/sequtils
+import testutils/unittests
+import libp2p/multiaddress
+import ../logos_delivery/waku/net/dialable
+
+proc ma(s: string): MultiAddress =
+  MultiAddress.init(s).get()
+
+suite "Dialable addresses":
+  test "a bound LAN endpoint is usable":
+    check:
+      ma("/ip4/192.168.1.173/tcp/53024").classify() == Usable
+      ma("/ip4/203.0.113.7/udp/60000/quic-v1").classify() == Usable
+      ma("/ip6/2001:db8::1/tcp/4001").classify() == Usable
+
+  test "loopback is usable -- it reaches this host":
+    ## The publish-side question about loopback is deliberately not asked here.
+    check:
+      ma("/ip4/127.0.0.1/tcp/53022").classify() == Usable
+      ma("/ip6/::1/tcp/4001").classify() == Usable
+
+  test "the wildcard bind host is not usable":
+    check:
+      ma("/ip4/0.0.0.0/tcp/53024").classify() == Wildcard
